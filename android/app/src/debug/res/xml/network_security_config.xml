<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Debug builds may contact a local HTTP backend during development.
        HTTPS connections still validate hostnames and certificates. The
        official GTS Root R4 is bundled for aftermarket Android head units
        whose system CA store rejects the WE1 certificate chain.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/gts_root_r4" />
        </trust-anchors>
    </base-config>
</network-security-config>
